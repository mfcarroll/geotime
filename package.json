{
  "name": "geotime-dashboard",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:prod": "op run --env-file=\".env.1password\" -- vite build --mode production",
    "preview": "vite preview --host",
    "sync-version": "capacitor-set-version",
    "ship-gateway": "node scripts/ship-gateway.mjs",
    "build:shiptest:ios": "VITE_SHIP_GATEWAY=http://localhost:8899 vite build --mode shiptest",
    "build:shiptest:android": "VITE_SHIP_GATEWAY=http://10.0.2.2:8899 vite build --mode shiptest",
    "shiptest:web": "export VITE_SHIP_GATEWAY=http://localhost:8899; vite build --mode shiptest && SHIP_MARKER=ship vite preview --mode shiptest --port 5173 --strictPort",
    "shiptest:web:ashore": "export VITE_SHIP_GATEWAY=http://localhost:8899; vite build --mode shiptest && vite preview --mode shiptest --port 5173 --strictPort",
    "deploy:utc-time": "wrangler deploy --config workers/utc-time/wrangler.jsonc",
    "deploy:rccl-proxy": "wrangler deploy --config workers/rccl-proxy/wrangler.jsonc",
    "deploy:ship-track": "wrangler deploy --config workers/ship-track/wrangler.jsonc",
    "deploy:workers": "npm run deploy:utc-time && npm run deploy:rccl-proxy && npm run deploy:ship-track",
    "typecheck:workers": "tsc --noEmit -p workers/tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import ./scripts/ts-resolve.mjs --test src/**/*.test.ts",
    "test:shared": "cd ios/SharedKit && swift test",
    "build:timezones": "node --import ./scripts/ts-resolve.mjs scripts/build-timezone-geojson.mjs --oceans"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@googlemaps/js-api-loader": "^1.16.10",
    "@types/google.maps": "^3.55.10",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/network": "^8.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "topojson-client": "^3.1.0"
  }
}
