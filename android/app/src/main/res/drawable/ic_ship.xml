<!-- Hull plus deckhouse. Same path as ShipShape in GeoTimeWidget.swift, so the
     two platforms show an identical mark; SF Symbols' ferry.fill needs iOS 16
     and this app targets 15.0. Two chunky forms rather than a detailed
     silhouette, because it renders at about 12dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="12dp"
    android:height="12dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/widget_pin"
        android:pathData="M2,14.5 H22 L18.5,21 H5.5 Z M7.5,14.5 V8 H14 V14.5 Z" />
</vector>
