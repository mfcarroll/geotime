# Google Maps API Key - Development
VITE_GOOGLE_MAPS_API_KEY="YOUR_API_KEY_HERE"

# Royal Caribbean APP Key (NOT a VITE_ variable)
RCCL_APPKEY=""

# Cloudflare Worker URLs (see workers/). Both are plain URLs, not secrets, so
# these ARE VITE_ variables — they have to reach the browser.
#
# VITE_RCCL_PROXY is what gives the *web* build ship features at all: a browser
# cannot call api.rccl.com directly (no CORS headers). Leave it unset and ship
# features are simply absent from the web build, which is the correct
# degradation. Native ignores it entirely and goes direct, because the proxy is
# unreachable from a ship's own network.
VITE_RCCL_PROXY="https://geotime-rccl-proxy.<subdomain>.workers.dev"

# VITE_UTC_TIME_URL replaces the console-authored Cloud Run function. Unset
# falls back to that function, so this is safe to leave blank until deployed.
VITE_UTC_TIME_URL="https://geotime-utc-time.<subdomain>.workers.dev"

# VITE_SHIP_TRACK serves ship position, past track and planned route. Unlike the
# RCCL proxy this one is used by EVERY platform, not just the web: the upstream
# sends no CORS headers and rejects non-browser clients, and it is unreachable
# from a ship's own network anyway, so there is nothing for a device to gain by
# going direct. Unset and the map layers are simply absent; clocks are unaffected.
VITE_SHIP_TRACK="https://geotime-ship-track.<subdomain>.workers.dev"
