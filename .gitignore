# wrangler
# Local secrets, never committed — the deployed value is a Worker secret.
.dev.vars
**/.dev.vars
# Miniflare's local dev state: sqlite caches and observability trace stores,
# regenerated on every `wrangler dev`.
.wrangler/

# App Store screenshots. Release assets, ~22MB, and regenerated from
# distribution/screenshots/README.md — the repo tracks how to make them
# rather than the images themselves.
distribution/screenshots/*/*.png

# SwiftPM build output for the widget-logic test package
ios/SharedKit/.build/

# Local-only inspection layers (scripts/tz-analysis/build-debug-layers.mjs)
public/debug-overlaps.geojson
public/debug-gaps.geojson
public/debug-adopted.geojson
